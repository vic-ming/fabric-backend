# --- 伺服器 ---
PORT=3100
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# --- 資料庫 ---
# 開發：pglite（免安裝，資料落在 .data/pglite）
DB_DRIVER=pglite
DB_DATA_DIR=.data/pglite
# 正式：改為 pg 並指向 Cloud SQL
# DB_DRIVER=pg
# DATABASE_URL=postgres://user:pass@host:5432/fabric

# --- 檔案儲存 ---
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# STORAGE_DRIVER=gcs
# GCS_BUCKET=fabric-assets

# --- 認證 ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# 首次啟動時自動建表並匯入預設資料
SEED_ON_BOOT=true

# --- TTRI（紡織所）TandemTex API ---
# 轉發用。token 只能放在後端，由本後端補上後轉發，絕不可出現在前端 bundle。
# 用 Cloud Run 的 HTTPS 網址：舊 VM（http://104.199.134.107:8001）的 8001 port 會被共享主機防火牆擋掉。
TTRI_API_BASE_URL=https://tandemtex-api-322968771523.asia-east1.run.app
TTRI_API_TOKEN=
# 文件規定：請求間隔建議 1 秒，每分鐘上限 30 次（超過會被暫停 5 秒）
TTRI_MIN_INTERVAL_MS=1000
TTRI_RATE_LIMIT_PER_MIN=30

# --- TTRI AI 生圖 API（Generate_pattern）---
# 交付文件僅提供 http://127.0.0.1:3000/，尚未取得正式位址，暫留空
TTRI_PATTERN_BASE_URL=

# 上傳上限（bytes）。一般上傳（印花、背景、3D 模型、組織資料）預設 200 MB
MAX_UPLOAD_BYTES=209715200
# 批次匯入的素材壓縮檔另計，預設 2 GB（一筆組織約 42 MB，約 45～50 筆）。檔案會先存到 tmp/imports 再逐筆處理，
# 記憶體用量與檔案大小無關；需要的磁碟空間約為檔案大小的兩倍（暫存 + 解出來的檔案）
IMPORT_MAX_BYTES=2147483648
