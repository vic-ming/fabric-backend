# --- 伺服器 ---
PORT=3100
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# --- 資料庫 ---
# 開發：pglite（免安裝，資料落在 .data/pglite）
DB_DRIVER=pglite
DB_DATA_DIR=.data/pglite
# 正式：改為 pg 並指向 Cloud SQL
# DB_DRIVER=pg
# DATABASE_URL=postgres://user:pass@host:5432/fabric

# --- 檔案儲存 ---
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# STORAGE_DRIVER=gcs
# GCS_BUCKET=fabric-assets

# --- 認證 ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# 首次啟動時自動建表並匯入預設資料
SEED_ON_BOOT=true
